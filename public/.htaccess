# ----------------------------------------------------------------------
# Aquabrim static export — server config
# NOTE: the site files live inside an /app/ folder on the server, but the
# public/canonical URLs are the clean root URLs (https://www.aquabrim.com/…).
# This file is deployed to  <webroot>/app/.htaccess.
# ----------------------------------------------------------------------

# ======================================================================
# Security headers (apply site-wide, incl. error responses via "always")
# ======================================================================
<IfModule mod_headers.c>
  # Force HTTPS for 1 year on this domain + all subdomains.
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

  # Disallow the site being framed by other origins (clickjacking).
  Header always set X-Frame-Options "SAMEORIGIN"

  # Stop browsers MIME-sniffing responses away from the declared type.
  Header always set X-Content-Type-Options "nosniff"

  # Send origin only on cross-origin requests; full URL same-origin.
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Content-Security-Policy — allowlist tuned to the third parties this
  # site actually uses: Google Tag Manager + GA4, Google Fonts, the
  # Google Maps embed iframe, and Google review avatars. 'unsafe-inline'
  # / 'unsafe-eval' are required because this is a static export (no
  # nonces) with inline GTM/GA and Next.js bootstrap scripts.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://aquabrim.com https://www.aquabrim.com https://cms.aquabrim.co.in https://www.google-analytics.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com https://maps.googleapis.com; frame-src 'self' https://www.google.com https://www.googletagmanager.com; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
</IfModule>

# ======================================================================
# Compression  (Core Web Vitals: FCP / LCP)
# Text assets were previously served UNCOMPRESSED — the CSS bundle alone is
# ~600 KB raw and gzips to roughly a tenth of that. Brotli is preferred when
# the module is present; mod_deflate is the fallback.
# ======================================================================
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/x-javascript
  AddOutputFilterByType BROTLI_COMPRESS application/json application/manifest+json
  AddOutputFilterByType BROTLI_COMPRESS image/svg+xml application/xml application/rss+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/manifest+json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml application/rss+xml

  # Don't waste CPU re-compressing already-compressed binaries.
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|ico|zip|gz|br|woff2?|mp4)$ no-gzip dont-vary
</IfModule>

# ======================================================================
# Cache headers  (Core Web Vitals: repeat-visit LCP + TTFB)
# /_next/static/* filenames are content-hashed by the build, so they are
# safe to cache immutably. HTML must always revalidate so content edits and
# new deploys are picked up straight away.
# ======================================================================
<IfModule mod_headers.c>
  <FilesMatch "\.(?:css|js|woff2?|ttf|eot|otf|svg|jpe?g|png|gif|webp|avif|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(?:html|json|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# Keep connections alive — saves a TLS handshake per asset.
<IfModule mod_headers.c>
  Header set Connection keep-alive
</IfModule>

# ======================================================================
# Old → new URL 301 redirects (SEO)
# ======================================================================
Options -MultiViews
RewriteEngine On
RewriteBase /

# --- /app/ duplicate → clean root URL (kill duplicate content) --------
# The files physically live under /app/, so BOTH the clean URL
# (/products/) and the /app/ URL (/app/products/) resolve to the same
# page = duplicate content. This .htaccess sits INSIDE /app/, so rewrite
# rules see paths relative to /app/ (i.e. "products/", not "app/products/").
# We therefore match the ORIGINAL request line via THE_REQUEST, which
# always contains what the browser actually asked for, and 301 any
# explicit /app/... URL to its clean root equivalent.
# (No loop: after redirecting to /products/, THE_REQUEST no longer
#  contains "/app/", so the rule doesn't fire again.)
RewriteCond %{THE_REQUEST} \s/+app/(\S*) [NC]
RewriteRule ^ /%1 [R=301,L]

# --- Page renames -----------------------------------------------------
RewriteRule ^about/?$                /about-us/             [R=301,L]
RewriteRule ^contact/?$              /contact-us/           [R=301,L]
RewriteRule ^blog/?$                 /blogs/                [R=301,L]
RewriteRule ^service/?$              /products/             [R=301,L]
RewriteRule ^terms-condition/?$      /terms-and-conditions/ [R=301,L]

# --- Product detail base path change ----------------------------------
# Old product pages lived under /service-details/<slug>. Send the whole
# section to the new /products/ base.
RewriteRule ^service-details/?$      /products/             [R=301,L]
RewriteRule ^service-details/(.+)$   /products/$1           [R=301,L]

# --- Flow Meter slug typo fix -----------------------------------------
RewriteRule ^products/flometer/?$    /products/flow-meter/  [R=301,L]
